<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".MainActivity"
    tools:showIn="@layout/main_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_bg">

        <!-- 百度地图：id 与所有交互一行未改 -->
        <com.baidu.mapapi.map.MapView
            android:id="@+id/bdMapView"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:clickable="true"
            android:focusable="true" />

        <!-- 点/画模式切换：默认点模式；画模式沿手指轨迹连续落点 -->
        <RadioGroup
            android:id="@+id/RadioGroupDrawMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="8dp"
            android:layout_marginTop="52dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/mode_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:minHeight="36dp"
                android:minWidth="52dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_chip"
                android:text="@string/mode_point"
                android:textColor="@color/nav_item_color"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/mode_draw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:button="@null"
                android:gravity="center"
                android:minHeight="36dp"
                android:minWidth="52dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_chip"
                android:text="@string/mode_draw"
                android:textColor="@color/nav_item_color"
                android:textSize="12sp" />
        </RadioGroup>

        <!-- 地图类型胶囊 chips：原有 mapNormal/mapSatellite 保留，新增夜间 chip -->
        <RadioGroup
            android:id="@+id/RadioGroupMapType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="52dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/mapNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_chip"
                android:text="@string/chip_map_normal"
                android:textColor="@color/nav_item_color"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/mapSatellite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:button="@null"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_chip"
                android:text="@string/chip_map_satellite"
                android:textColor="@color/nav_item_color"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/chip_map_night"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:button="@null"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_chip"
                android:text="@string/chip_map_night"
                android:textColor="@color/nav_item_color"
                android:textSize="12sp" />
        </RadioGroup>

        <!-- 右侧竖排控制：原 id 保留，深色圆形底 + 青色 tint -->
        <ImageButton
            android:id="@+id/cur_position"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="350dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="@string/cur_position"
            android:theme="@style/RippleWhite"
            app:srcCompat="@drawable/ic_home_position"
            app:tint="@color/dark_accent" />

        <ImageButton
            android:id="@+id/zoom_in"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="403dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="@string/zoom_in"
            android:theme="@style/RippleWhite"
            app:srcCompat="@drawable/ic_zoom_in"
            app:tint="@color/dark_accent" />

        <ImageButton
            android:id="@+id/zoom_out"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="456dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="@string/zoom_out"
            android:theme="@style/RippleWhite"
            app:srcCompat="@drawable/ic_zoom_out"
            app:tint="@color/dark_accent" />

        <ImageButton
            android:id="@+id/input_pos"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="240dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="@string/input_button"
            android:theme="@style/RippleWhite"
            app:srcCompat="@drawable/ic_input"
            app:tint="@color/dark_accent" />

        <!-- 多点路线：信息条 + 操作按钮行（替换原「当前选中位置」栏位，置于底部） -->
        <LinearLayout
            android:id="@+id/route_info_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="88dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_route_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/route_info_fmt"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 闭环时显示：圈数设置（默认 1，范围 1-99） -->
            <LinearLayout
                android:id="@+id/route_loops_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/route_loops_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_route_loops"
                    android:layout_width="64dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/border_window"
                    android:gravity="center"
                    android:hint="@string/route_loops_hint"
                    android:inputType="number"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_route_closed_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textColor="@color/dark_accent"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_route_undo"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:enabled="false"
                    android:text="@string/route_undo"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_route_clear"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:enabled="false"
                    android:text="@string/route_clear"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_route_favorite"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:enabled="false"
                    android:text="@string/route_favorite_line"
                    android:textColor="@color/dark_accent"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_route_open_favorites"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:text="@string/route_open_favorites"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center_horizontal|center_vertical"
            android:textSize="10sp"
            android:text="@string/app_statement"
            android:visibility="gone"
            tools:ignore="SmallSp" />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
