<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    app:iconSpaceReserved="false">

    <PreferenceCategory
        app:title="@string/setting_group_move"
        app:iconSpaceReserved="false">
        <ListPreference
            app:key="setting_joystick_type"
            app:title="@string/setting_joystick_type"
            app:entries="@array/array_joystick_type"
            app:entryValues="@array/array_joystick_type_values"
            app:dialogTitle="@string/setting_joystick_type"
            app:defaultValue="0"
            app:iconSpaceReserved="false">
        </ListPreference>

        <EditTextPreference
            app:key="setting_walk_cadence"
            app:title="@string/setting_walk_cadence"
            app:defaultValue="@string/setting_walk_cadence_default"
            app:summary="@string/setting_walk_cadence_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_walk_stride"
            app:title="@string/setting_walk_stride"
            app:defaultValue="@string/setting_walk_stride_default"
            app:summary="@string/setting_walk_stride_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_run_cadence"
            app:title="@string/setting_run_cadence"
            app:defaultValue="@string/setting_run_cadence_default"
            app:summary="@string/setting_run_cadence_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_run_stride"
            app:title="@string/setting_run_stride"
            app:defaultValue="@string/setting_run_stride_default"
            app:summary="@string/setting_run_stride_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_bike"
            app:title="@string/setting_bike"
            app:defaultValue="@string/setting_bike_default"
            app:summary="@string/setting_bike_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_altitude"
            app:title="@string/setting_altitude"
            app:defaultValue="@string/setting_altitude_default"
            app:summary="@string/setting_altitude_default"
            app:iconSpaceReserved="false"/>

        <!-- 深色化新增视觉项：移动方向 / 定位精度 / 更新间隔（P0 仅 SP 存储，P1 联动 ServiceGo） -->
        <ListPreference
            app:key="setting_move_direction"
            app:title="@string/setting_move_direction"
            app:entries="@array/array_move_direction"
            app:entryValues="@array/array_move_direction_values"
            app:dialogTitle="@string/setting_move_direction"
            app:defaultValue="auto"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_location_accuracy"
            app:title="@string/setting_location_accuracy"
            app:defaultValue="@string/setting_location_accuracy_default"
            app:summary="@string/setting_location_accuracy_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_update_interval"
            app:title="@string/setting_update_interval"
            app:defaultValue="@string/setting_update_interval_default"
            app:summary="@string/setting_update_interval_default"
            app:iconSpaceReserved="false"/>

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_location_offset"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="setting_random_offset"
            app:title="@string/setting_random_offset"
            app:summary="@string/setting_random_offset_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>
        <EditTextPreference
            app:key="setting_lat_max_offset"
            app:title="@string/setting_lat_max_offset"
            app:defaultValue="@string/setting_random_offset_default"
            app:summary="@string/setting_random_offset_default"
            app:iconSpaceReserved="false"/>
        <EditTextPreference
            app:key="setting_lon_max_offset"
            app:title="@string/setting_lon_max_offset"
            app:defaultValue="@string/setting_random_offset_default"
            app:summary="@string/setting_random_offset_default"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_log"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="setting_log_off"
            app:title="@string/setting_log_off"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>
        <EditTextPreference
            app:key="setting_history_expiration"
            app:title="@string/setting_history_expiration"
            app:defaultValue="@string/history_expiration"
            app:summary="@string/history_expiration"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <!-- 深色化新增分组：悬浮摇杆显示开关 -->
    <PreferenceCategory
        app:title="@string/setting_group_joystick"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="setting_joystick_show"
            app:title="@string/setting_joystick_show"
            app:summary="@string/setting_joystick_show_summary"
            app:defaultValue="true"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <!-- 以下 4 个密钥 Preference 及顺序保持原样（上一轮成果，禁止改动） -->
    <PreferenceCategory
        app:title="@string/setting_group_map_key"
        app:iconSpaceReserved="false">

        <EditTextPreference
            app:key="setting_map_key"
            app:title="@string/setting_map_key"
            app:summary="@string/setting_map_key_summary"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_map_safe_code"
            app:title="@string/setting_map_safe_code"
            app:summary="@string/setting_map_safe_code_summary"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_amap_key"
            app:title="@string/setting_amap_key"
            app:summary="@string/setting_amap_key_summary"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_tencent_key"
            app:title="@string/setting_tencent_key"
            app:summary="@string/setting_tencent_key_summary"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_about"
        app:iconSpaceReserved="false">

        <Preference
            app:key="setting_version"
            app:title="@string/setting_version"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="setting_author"
            app:title="@string/setting_author"
            app:defaultValue="@string/app_author"
            app:summary="@string/app_author"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>
</PreferenceScreen>